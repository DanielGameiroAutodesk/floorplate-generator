.IconCarousel {
  /* These attributes are specific to the icon carousel's current placement in
   * the row house property panel, so should be refactored if used somewhere else */
  grid-column: input-a;
  grid-row: span 2;
  height: 100%;

  border: 1px solid rgba(128, 128, 128, 0.2);
  display: flex;

  .ArrowLeft {
    height: 100%;
    transform: rotate(180deg);
  }
  .ArrowRight {
    height: 100%;
  }

  .CarouselMain {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;

    .Filler {
      flex: 1;
    }

    .IconWrapper {
      display: flex;
      height: 24px;
    }

    .SelectorCircles {
      display: flex;

      svg circle {
        fill: #808080;
        fill-opacity: 0.5;
      }
      svg.ActiveSelector circle {
        fill-opacity: 0.75;
      }
      svg:hover circle {
        fill: var(--icon-color-selected-focus);
        fill-opacity: 1;
      }
    }
  }
}
