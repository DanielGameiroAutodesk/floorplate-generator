.ConnectingLine {
  position: absolute;
  border: none;
  border-bottom: 1px dashed #777;
  height: 1px;
}

.RadiusInputWrapper {
  position: absolute;
  z-index: var(--z-secondary-navigation);
  display: grid;
  grid-gap: 6px;
  background-color: var(--background-color-surface-100);
  padding: 4px;
  border-radius: 3px;
  box-shadow:
    0 4px 16px rgba(0, 0, 0, 0.05),
    0px 3px 8px rgba(0, 0, 0, 0.04);
}
