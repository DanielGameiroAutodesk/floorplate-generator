:root {
  --scenario-purple: #b37bfc;
  /* 30% transparency */
  --scenario-purple-30: #b37bfc4d;
  /* 15% transparency */
  --scenario-purple-15: #b37bfc26;
}

.Wrapper {
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.Container {
  --color-icon: var(--icon-color-medium);
  --color-button: var(--icon-color-medium);
  --color-text: var(--text-color-medium-default);
  --background-color-hovered: var(--background-color-selected-default);
  --background-color-selected: var(--background-color-selected-default);
  --border-color-selected: var(--border-color-selected);

  padding: 0 6px;
  flex: 1;
  overflow: hidden auto;
}

.Name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.BaseNameEdit {
  padding-right: 1rem;
  width: 100%;
  overflow: visible;
}

.Divider {
  color: var(--border-color-divider-light);
  margin: 4px 8px;
  border-style: solid;
  border-top: none;
}

.ButtonDisabled {
  opacity: 0.5;
  pointer-events: none;
}

.ObjectListHeader {
  display: flex;
  align-items: center;
  padding: 0px 16px;
  justify-content: space-between;
  color: var(--text-color-medium-default);
  flex: 0 0 48px;
  height: 48px;
}

.ObjectListHeader h4 {
  font: var(--12-bold);
}

.Category {
  display: flex;
  align-items: center;
  min-height: 32px;
  border: 1px solid transparent;
  box-sizing: border-box;
  font: var(--11-regular);
  user-select: none;
  cursor: default;
  margin-bottom: 2px;

  &.scenario {
    padding-left: 24px;
  }

  &.selected {
    border: 1px solid var(--border-color-selected);
    background-color: var(--background-color-selected);
  }
}

.ActiveContext .Category {
  cursor: pointer;
}

.Category.hidden,
.Scenario.hidden .Category {
  & button,
  & .Name,
  & .Icon {
    opacity: 0.5;
  }
}

.BaseLayerIcon {
  > input {
    width: 16px;
  }
}

.Scenario:hover,
.EditedScenario,
.Category:not(.ScenarioHeader):hover,
.Category.hovered {
  background-color: var(--background-color-hovered);
}

.Layers {
  overflow: hidden;
  height: 100%;
}

.Icon,
.Arrow {
  height: 16px;
  padding-left: 10px;
  padding-right: 8px;
  color: var(--color-icon);
}
.Arrow {
  display: none;
}

.Buttons {
  padding-right: 10px;
  color: var(--color-button);
  display: flex;
}

.VisibilityToggle,
.LockToggle {
  border: none;
  padding: 0;
  overflow: visible;
  cursor: pointer;
  background: transparent;
}

.VisibilityToggle:disabled,
.LockToggle:disabled {
  opacity: 0.5;
  pointer-events: none;
}
.DisabledEditTerrainButton {
  opacity: 0.5;
}

/* visibility toggle icons */

.VisibilityToggle {
  visibility: hidden;
}

.Scenario,
.Category,
.Category {
  &.hidden,
  &:hover {
    & .VisibilityToggle {
      visibility: visible;
    }
  }
}

.HiddenIcon {
  display: none;
}

.VisibleIcon {
  display: inline-block;
}

/* lock toggle icons */
.LockToggle {
  visibility: hidden;
}

.ActiveContext .LockToggle {
  display: block;
}

.Category:hover .LockToggle,
.Category.locked .LockToggle {
  visibility: visible;
}

.LockedIcon {
  /* display: none; */
}

.UnlockedIcon {
  /* display: inline-block; */
}

.EmptyLayersContainer {
  font: var(--11-regular);
  padding: 10px 0;
  margin-left: 36px;
}

.EmptyLayersContainer > svg {
  margin: 10px 0;
}

.EmptyLayersContainer > * {
  max-width: 180px;
  margin-bottom: 8px;
}

.EmptyLayersContainer a {
  display: inline-block;
  color: var(--text-color-medium-default);
  text-decoration: none;
  cursor: pointer;

  &:hover {
    text-decoration: underline;
  }
}

.ScenarioHeader {
  height: 32px;
}

.Purple {
  --background-color-hovered: var(--scenario-purple-15);
  --background-color-selected: var(--scenario-purple-15);
  --border-color-selected: var(--scenario-purple);
  --color-icon: var(--scenario-purple);
}

.Scenario {
  overflow: hidden;
  flex: 1;
  display: flex;
  flex-direction: column;
  --background-color-hovered: var(--scenario-purple-15);
  --background-color-selected: var(--scenario-purple-15);
  --border-color-selected: var(--scenario-purple);
  --color-icon: var(--scenario-purple);

  .Layers {
    .Category {
      padding-left: 24px;
    }
  }

  &.collapsed {
    & .Layers {
      height: 0;
      overflow: hidden;
    }

    & .CollapseChevron {
      transform: rotate(-90deg);
    }
  }

  &.EditedScenario .ScenarioHeader {
    background-color: var(--scenario-purple);
    color: white;
    --background-color-hovered: var(--scenario-purple-15);
    --background-color-selected: var(--scenario-purple-15);
    --border-color-selected: var(--scenario-purple-30);
    --color-icon: white;
    --color-text: white;
    --color-button: white;
  }
}

.CollapseChevron {
  display: none;
  transition: transform 150ms;
}

.ScenarioHeader {
  &:hover {
    & .Icon {
      & .CollapseChevron {
        display: inline-block;
      }

      & > .BaseHeaderIcon {
        display: none;
      }
    }
  }
}

.BaseHeaderIcon {
  background-color: var(--scenario-purple-15);
  border-radius: 2px;
  min-width: 16px;
  width: 16px;
  min-height: 16px;
  height: 16px;
  justify-content: center;
  align-items: center;

  font: var(--11-bold);
  box-sizing: border-box;
  display: flex;
  text-align: center;
  color: var(--color-icon);
}

.IndicatorInputField {
  height: 16px;
  width: 16px;
}

.Buttons {
  display: flex;
  justify-content: right;
  gap: 8px;
  /* visibility: hidden; */

  & button {
    border: none;
    background: none;
    color: inherit;
    min-height: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
  }
}

.SwapBaseItem {
  display: flex;
  white-space: nowrap;
  align-items: center;
  --color-icon: var(--icon-color-medium);
  --color-text: var(--text-color-medium-default);
  color: var(--color-text);

  & .BaseHeaderIcon {
    margin-right: 8px;
  }
}

.SelectedCategoryTitle {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 8px;
  cursor: pointer;

  & forma-icon-arrow-left {
    height: 16px;
  }
}

.Tooltip {
  position: relative;
  width: 200px;
  height: 200px;
}

.ProgressContainer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: transparent;
  z-index: 1;
}
