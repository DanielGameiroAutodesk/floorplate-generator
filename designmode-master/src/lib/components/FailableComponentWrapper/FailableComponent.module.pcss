.failedComponent {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px 6px;
  line-height: 37px !important;
  justify-content: center;
  border-radius: 3px;
  font: var(--11-regular);
}

.description {
  display: flex;
  align-items: center;

  & svg {
    margin-right: 6px;
  }
}

.darkMode {
  color: #ffffff;
}
