.SceneToolsWrapper {
  position: relative;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  z-index: 2;
  pointer-events: all;
}

.SceneToolsToolbar {
  display: flex;
  background-color: var(--background-color-surface-100);
  box-shadow: var(--effect-shadow-high);
  border: none;
  border-radius: 4px;
  padding: 0 4px;
  height: 36px;
}

.SceneToolsButton {
  padding: 6px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--icon-color-medium);
  &:hover {
    color: var(--icon-color-control-hover);
  }
}

.SceneToolsIcon24 {
  display: block;
  width: 24px;
  height: 24px;
}
