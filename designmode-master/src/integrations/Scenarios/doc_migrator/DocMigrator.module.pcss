.Container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100vw;
  height: 100vh;
  background: var(--background-color-surface-200, #f5f5f5);
}

.Modal {
  background: var(--background-color-surface-100, #ffffff);
  border-radius: 8px;
  border: 1px solid var(--border-color-primary, #e0e0e0);
  box-shadow: var(--effect-shadow-high, 0 4px 16px rgba(0, 0, 0, 0.15));
  max-width: 520px;
  padding: 32px;
}

.IconContainer {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background: var(--background-color-warning-subtle, #fff3cd);
  border-radius: 50%;
  margin-bottom: 16px;
  color: var(--text-warning, #856404);
}

.Title {
  font: var(--20-bold, bold 20px/1.4 sans-serif);
  color: var(--text-primary, #3c3c3c);
  margin: 0 0 16px 0;
}

.Description {
  font: var(--14-regular, 400 14px/1.5 sans-serif);
  color: var(--text-secondary, #6b6b6b);
  line-height: 22px;
  margin: 0 0 24px 0;
}

.Highlight {
  font: var(--14-medium, 500 14px/1.5 sans-serif);
  color: var(--text-primary, #3c3c3c);
}

.ButtonContainer {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 24px;
}

.Button {
  padding: 8px 16px;
  border-radius: 4px;
  font: var(--14-medium, 500 14px/1.5 sans-serif);
  cursor: pointer;
  transition:
    background-color 0.2s,
    border-color 0.2s;
}

.ButtonPrimary {
  background: var(--button-solid-background, #0696d7);
  color: var(--button-solid-text, #ffffff);
  border: none;
}

.ButtonPrimary:hover {
  background: var(--button-solid-background-hover, #0580b8);
}

.ButtonSecondary {
  background: transparent;
  color: var(--text-primary, #3c3c3c);
  border: 1px solid var(--border-color-primary, #c0c0c0);
}

.ButtonSecondary:hover {
  background: var(--background-color-surface-200, #f5f5f5);
}

.Loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  padding: 24px;
}

.LoadingText {
  font: var(--14-regular, 400 14px/1.5 sans-serif);
  color: var(--text-secondary, #6b6b6b);
}

.Error {
  color: var(--text-error, #d32f2f);
  font: var(--14-regular, 400 14px/1.5 sans-serif);
  margin-bottom: 16px;
}
