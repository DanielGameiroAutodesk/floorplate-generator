.dialog {
  width: 212px;
  color: var(--text-color-medium-default);
  font: var(--11-medium);
  display: flex;
  margin-top: 4px;
  align-items: left;
  flex-direction: column;
  gap: 4px;

  & .title {
    font: var(--11-regular);
    margin-bottom: 8px;
    line-height: 14px;
  }

  & .selectionTags {
    display: flex;
    margin-bottom: 12px;
    gap: 4px;
    max-width: 360px;
    max-height: 600px;
    flex-wrap: wrap;
    overflow-y: auto;
  }

  & .emptyTags {
    display: flex;
    align-items: left;
    flex-direction: column;
  }
}

.selectionButton {
  white-space: nowrap;
  background-color: var(--background-color-neutral-high-default);
  border-width: 1px;
  border-style: solid;
  border-radius: 4px;
  font: var(--11-medium);
  padding: 4px 6px;
  cursor: pointer;
  outline: none;
  position: relative;
  transition: all 0.2s;

  border-color: transparent;

  &.buttonSelected {
    background-color: var(--background-color-selected-default);
    border-color: var(--border-color-accent-default);

    &:hover {
      background-color: var(--background-color-selected-hover);
    }

    &:active {
      background-color: var(--background-color-selected-pressed);
    }
  }

  &:hover {
    background-color: var(--background-color-neutral-high-hover);
  }

  &:focus {
    outline: 2px solid var(--halo-color-neutral-focus);
  }

  &:active {
    background-color: var(--background-color-neutral-high-pressed);
  }
}

.fullRow {
  flex: 0 0 100%;
  width: 100%;
}

.entireModelOption {
  margin-bottom: 8px;
}

@keyframes pulse {
  0% {
    transform: scale(0.1);
    opacity: 1;
  }
  10% {
    transform: scale(1);
    opacity: 0.6;
  }
  100% {
    transform: scale(1);
    opacity: 0;
  }
}
