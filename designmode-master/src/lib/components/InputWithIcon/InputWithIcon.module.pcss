.InputWithIcon {
  flex-basis: calc(16px + 8px + 72px);
  flex-shrink: 0;
  flex-grow: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;

  & > * + * {
    margin-left: 8px;
    flex-grow: 1;
  }
}

.Icon {
  width: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--icon-color-medium);
}
