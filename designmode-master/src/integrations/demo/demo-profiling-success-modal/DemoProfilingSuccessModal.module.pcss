.Dialog {
  border: none;
  border-radius: 8px;
  padding: 0;
  background: var(--background-color-surface-100);
  box-shadow: var(--effect-shadow-high);
  width: 700px;
  height: 400px;
  overflow: hidden;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  margin: 0;

  &::backdrop {
    background-color: var(--background-color-overlay-screen);
  }
}

.CloseButtonWrapper {
  position: absolute;
  top: 8px;
  right: 8px;
}

.CloseButton {
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  color: var(--icon-color-heavy);

  &:hover {
    opacity: 0.7;
  }
}

.ModalContainer {
  display: flex;
  width: 100%;
  height: 100%;
}

.ModalContent {
  display: flex;
  flex: 1;
  height: 400px;
}

.ImageSection {
  width: 300px;
  height: 400px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background-color: var(--background-color-surface-250);
  overflow: hidden;
}

.Image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.ContentSection {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 48px;
}

.HeaderText {
  font: var(--11-bold);
  color: var(--text-color-light);
  margin: 0;
  margin-top: 32px;
}

.TitleText {
  font: var(--24-bold);
  color: var(--text-color-medium-default);
  margin: 0;
  padding: 0;
  margin-top: 2px;
}

.DescriptionText {
  font: var(--12-regular);
  color: var(--text-color-medium-default);
  margin: 0;
  margin-top: 16px;
}

.CallToActionText {
  font: var(--12-regular);
  color: var(--text-color-medium-default);
  margin: 0;
  margin-top: 16px;
}

.ButtonContainer {
  display: flex;
  gap: 12px;
  justify-content: flex-start;
  flex-direction: row-reverse;
  padding: 0;
  margin-top: 24px;

  weave-button {
    --button-height: 34px;
  }
}
