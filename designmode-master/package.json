{
  "name": "designmode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "pnpm run build:packages && DEV_SERVER=1 vite",
    "build": "pnpm run build:packages && pnpm run build:vite",
    "build:vite": "SENTRY_RELEASE=$(git rev-parse --short HEAD) vite build",
    "build:packages": "pnpm -r --filter='./packages/**' run build",
    "preview": "SENTRY_RELEASE=$(git rev-parse --short HEAD) vite build --sourcemap true --minify false && DEV_SERVER=1 REGION=eu pnpm vite preview",
    "deploy": "pnpm build && pnpm sm-webapp deploy-s3",
    "deploy-stack": "pnpm build && pnpm sm-webapp deploy",
    "deploy:packages": "pnpm publish -r",
    "lint": "eslint --max-warnings=0 --cache",
    "sentry-release": "SENTRY_RELEASE=$(git rev-parse --short HEAD) node .github/sentry-release.js",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest",
    "all": "pnpm tsc && pnpm lint && pnpm vitest run",
    "build-docs": "pnpm typedoc",
    "serve-docs": "http-server docs -c-1",
    "gha-run-playwright": "pnpm run build:packages && cd checkly && pnpm test-local src/smoke-test.spec.ts",
    "test3ds": "RANDPORT=1 pnpm --prefix ./checkly run test-local-3d-sketch",
    "test3dsci": "pnpm --prefix ./checkly run test-local-3d-sketch-ci"
  },
  "pnpm": {
    "overrides": {
      "@spacemakerai/adsk-formit-core-standalone": "$@spacemakerai/adsk-formit-core-standalone",
      "three": "$three"
    }
  },
  "dependencies": {
    "@gltf-transform/core": "^4.0.8",
    "@kninnug/constrainautor": "^4.0.0",
    "@preact/signals": "^2.0.0",
    "@sentry/browser": "^10.0.0",
    "@spacemakerai/add": "workspace:*",
    "@spacemakerai/adsk-formit-core-standalone": "1.174.0",
    "@spacemakerai/elements-client": "^2.5.1",
    "@spacemakerai/fetch-enhance": "^3.4.2",
    "@spacemakerai/forma-units": "^2.2.1",
    "@spacemakerai/globalization": "^1.4.0",
    "@spacemakerai/line-buildings-shared": "workspace:*",
    "@spacemakerai/orbit-controls-common": "1.2.2",
    "@spacemakerai/react-wc-wrapper": "^2.1.4",
    "@spacemakerai/web-sketch-renderer": "17.0.1",
    "@spacemakerai/webapp-analytics": "^2.5.0",
    "@turf/boolean-point-in-polygon": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "@turf/kinks": "^7.1.0",
    "@turf/line-offset": "^7.1.0",
    "@types/proj4": "^2.5.5",
    "delaunator": "^5.0.1",
    "earcut": "^3.0.0",
    "epsg-index": "^2.0.0",
    "fast-deep-equal": "^3.1.3",
    "flatbush": "^4.4.0",
    "forma-elements": "^2.4.0",
    "history": "^5.3.0",
    "html2canvas": "^1.4.1",
    "hull.js": "andriiheonia/hull#semver:^1.0.10",
    "jszip": "^3.10.1",
    "line-of-closest-approach": "^0.0.2",
    "lodash": "^4.17.21",
    "moize": "^6.1.5",
    "offset-polygon": "^0.9.2",
    "p-limit": "^6.0.0",
    "p-map": "^7.0.2",
    "pako": "^2.1.0",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.0.1",
    "preact": "10.24.2",
    "proj4": "^2.12.0",
    "rbush-3d": "^0.0.4",
    "react": "npm:@preact/compat",
    "react-colorful": "^5.6.1",
    "react-dom": "npm:@preact/compat",
    "recoil": "0.7.7",
    "robust-point-in-polygon": "^1.0.3",
    "simplify-geometry": "^0.0.2",
    "sparse-octree": "^7.1.5",
    "suncalc": "^1.9.0",
    "three": "0.174.0",
    "three-mesh-bvh": "^0.9.0",
    "uuid": "^11.0.0",
    "voronoi": "^1.0.0",
    "webgl-memory": "^1.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-react-jsx-development": "^7.24.7",
    "@eslint/js": "^9.19.0",
    "@preact/preset-vite": "^2.9.0",
    "@sentry/cli": "^2.40.0",
    "@spacemakerai/element-types": "^13.0.4",
    "@spacemakerai/sm-webapp-cli": "^3.20.0",
    "@spacemakerai/vite-csp-plugin": "^2.2.8",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/preact": "^3.2.4",
    "@types/body-parser": "^1.19.5",
    "@types/delaunator": "^5.0.3",
    "@types/dom-navigation": "^1.0.5",
    "@types/earcut": "^2.1.4",
    "@types/geojson": "^7946.0.14",
    "@types/hull.js": "^1.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/lodash": "^4.17.7",
    "@types/pako": "^2.0.3",
    "@types/polylabel": "^1.1.3",
    "@types/robust-point-in-polygon": "^1.0.4",
    "@types/suncalc": "^1.9.2",
    "@types/three": "0.174.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/types": "^8.23.0",
    "@typescript-eslint/utils": "^8.23.0",
    "@vitest/ui": "^3.1.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-module-utils": "^2.12.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "glob": "^11.0.0",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "jiti": "^2.3.3",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.3",
    "postcss-nesting": "^13.0.1",
    "prettier": "^3.3.3",
    "typedoc": "^0.28.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "8.46.4",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "tabWidth": 2
  },
  "webapp": {
    "appName": "designmode",
    "tags": {
      "owner": "design-mode",
      "adsk:environment": "design-mode",
      "aws-backup-ignore": "true"
    },
    "enableVersioning": true,
    "metadata": {
      "assets/FormIt.ems-*.wasm": {
        "Cache-Control": "max-age=86400,immutable"
      }
    }
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
