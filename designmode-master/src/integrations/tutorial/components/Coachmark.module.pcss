/* Shared styles for all tutorial step components */
.TutorialStep {
  background: var(--background-color-surface-100);
  border-radius: 4px;
  box-shadow: var(--effect-shadow-high);
  width: 314px;
  pointer-events: auto;
}

.Header {
  font: var(--14-bold);
  color: var(--text-color-medium-default);
  display: flex;
  align-items: center;
  border-bottom: 1px solid var(--border-color-divider-light);
  padding: 16px;
  justify-content: space-between;
}

.HeaderContent {
  display: flex;
  gap: 10px;
  align-items: center;
}

.Body {
  font: var(--12-regular);
  color: var(--text-color-medium-default);
  padding: 16px;
  line-height: 150%;
}

.BodyCoachmark {
  font: var(--12-regular);
  color: var(--text-color-medium-default);
  padding: 16px;
  line-height: 150%;
  padding-bottom: 24px;
}

.Footer {
  padding: 0 16px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.FooterText {
  font: var(--12-medium);
  color: var(--text-color-medium-default);
}

.Image {
  padding: 24px 16px 8px 16px;
  display: flex;
  max-width: 100%;
  max-height: 200px;
  justify-content: center;
  overflow: hidden;
}

.Image img {
  width: 100%;
  max-height: 100%;
  object-fit: cover;
}

/* Positioning containers */
.CenteredContainer {
  position: fixed;
  top: 250px;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: calc(var(--z-notification) + 2);
}

.PositionedContainer {
  position: fixed;
  z-index: calc(var(--z-notification) + 2);
  width: fit-content;
  height: fit-content;
}

/* Arrow styles for positioned modals */
.Arrow {
  position: absolute;
  width: 0;
  height: 0;
  border: 8px solid transparent;
}

.ArrowTop {
  bottom: -16px;
  /* left position will be set dynamically via inline style */
  /* Default to center if no dynamic position provided */
  left: 50%;
  transform: translateX(-50%);
  border-top-color: var(--background-color-surface-100);
}

.ArrowBottom {
  top: -16px;
  /* left position will be set dynamically via inline style */
  /* Default to center if no dynamic position provided */
  left: 50%;
  transform: translateX(-50%);
  border-bottom-color: var(--background-color-surface-100);
}

.ArrowLeft {
  right: -16px;
  /* top position will be set dynamically via inline style */
  /* Default to center if no dynamic position provided */
  top: 50%;
  transform: translateY(-50%);
  border-left-color: var(--background-color-surface-100);
}

.ArrowRight {
  left: -16px;
  /* top position will be set dynamically via inline style */
  /* Default to center if no dynamic position provided */
  top: 50%;
  transform: translateY(-50%);
  border-right-color: var(--background-color-surface-100);
}
