.Wrapper {
  display: flex;
  flex-direction: column;
  height: 24px;
  width: 110px;
}

.TooltipsWrapper {
  position: relative;
  display: flex;
  flex-direction: row;
  margin-top: 4px;
}

/* using tooltip styling from https://github.com/spacemakerai/design-system/blob/13d819713fd170d8b36d2964fec55306faacd0b1/core-v2/src/weave/components/tooltip/weave-tooltip.css */
.Tooltip {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-sizing: border-box;
  position: fixed;
  z-index: calc(var(--z-primary-navigation) + 30);
  background-color: #3c3c3c;
  color: #e1ebf7;
  padding: 8px 12px;
  border-radius: 2px;
  width: max-content;
  min-height: 32px;
  pointer-events: none;
  font: var(--high-small-regular);
  overflow-wrap: normal;
  white-space: pre-line;
  line-height: 18px;
}

.Tooltip.Active {
  opacity: 1;
  transition-property: opacity, box-shadow, color;
  transition-delay: 300ms;
  transition-duration: 150ms;
  transition-timing-function: cubic-bezier(1, 0.41, 0.27, 2);
  box-shadow: -2px 2px 4px rgb(0 0 0 / 20%);
  pointer-events: none;
}

.Tooltip.Inactive {
  opacity: 0;
  visibility: hidden;
  transition-property: opacity, box-shadow, color;
  transition-duration: 50ms;
  transition-timing-function: cubic-bezier(1, 0.41, 0.27, 2);
  box-shadow: 0 0 0 rgba(0, 0, 0, 0.2);
}

/* The arrow */
.Tooltip::after {
  display: var(--arrow-display);
  position: absolute;
  z-index: calc(var(--z-primary-navigation) + 30);
  content: "";
  border: 4px solid transparent;
  border-bottom: 4px solid #3c3c3c;
  top: -8px;
  left: calc(100% - 16px);
  transform: rotate(0deg);
}
