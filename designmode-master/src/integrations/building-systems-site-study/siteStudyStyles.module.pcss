.pickerContainer {
  height: 160px;
  display: flex;
  flex-direction: column;
  font-family: "Artifakt Element", sans-serif;
  color: #3c3c3c;
  /*background: rgba(0, 0, 0, 0.2);*/
  border-radius: 4px;
  width: 805px;
  @media (max-width: 115rem) {
    width: 672px;
  }
  @media (max-width: 102rem) {
    width: 539px;
  }

  @media (max-width: 89rem) {
    width: 406px;
  }

  @media (max-width: 75rem) {
    width: 273px;
  }

  @media (max-width: 61rem) {
    width: 140px;
  }
  margin: 0 0 12px;
}

.picker {
  height: 100%;
  width: 100%;
  padding: var(--padding);
  box-sizing: border-box;
  display: flex;
  align-self: center;
  flex-direction: row;
  justify-content: space-between;
  overflow-x: auto;
  /* Hide scrollbar for IE, Edge and Firefox */
  -ms-overflow-style: none; /* IE and Edge */
  scrollbar-width: none; /* Firefox */
  position: relative;
  > .study:first-child {
    margin-left: 0;
  }
  > .study {
    margin-left: 17px;
  }
}

/* Hide scrollbar for Chrome, Safari and Opera */
.picker::-webkit-scrollbar {
  display: none;
}

.pages {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  left: 50%;
  bottom: 13px;
  > .pageSelector:first-child {
    margin-left: 0;
  }
  > .pageSelector {
    margin-left: 8px;
  }
}

.pageSelector {
  height: 8px;
  width: 8px;
  border-radius: 100%;
  background: #ffffff;
  cursor: pointer;
}

.selectedPage {
  background: #9bd5ef;
}

.scrollNext::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 40px;
  width: 40px;
  background: transparent;
}

.scrollNext::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 40px;
  width: 40px;
  background: transparent;
}

.study {
  padding: 8px;
  height: 100%;
  align-items: center;
  display: flex;
  box-sizing: border-box;
}

.thumbnail {
  width: 100px;
  height: 100px;
}

.thumbnail:hover > .sitePolygon {
  fill: var(--background-on-focus);
}

.sitePolygonLoading {
  background: linear-gradient(
    to right,
    rgba(245, 245, 245, 0.8) 0%,
    rgba(255, 255, 255, 0.1) 50%,
    rgba(245, 245, 245, 0.8) 100%
  );
  animation: linearAnim 2s infinite linear;
}

@keyframes linearAnim {
  0% {
    background-position: 0 0;
  }
  100% {
    background-position: 100px 0;
  }
}

.thumbnailBuildingFootprint {
  filter: drop-shadow(0px 1px 1px rgba(0, 0, 0, 0.5));
}

.gradientBackground {
  position: absolute;
  left: 0;
  bottom: 0;
  pointer-events: none;
  width: 100vw;
  height: 300px;
  background: linear-gradient(0, rgba(0, 0, 0, 0.4) 0%, rgba(135, 135, 135, 0) 100%);
}
