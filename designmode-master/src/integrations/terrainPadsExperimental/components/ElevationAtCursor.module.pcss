.ElevationAtCursorWrapper {
  position: fixed;
  top: 0;
  left: 0;
  font: var(--font-meta2);
  color: var(--gray10);
  background: #ffffff;
  box-shadow:
    0 3px 8px rgba(0, 0, 0, 0.04),
    0 4px 16px rgba(0, 0, 0, 0.05);
  border-radius: 2px;
  padding: 0.2em 0.6rem;
  white-space: pre;
}

.Unit {
  font: var(--font-meta2);
  color: var(--gray50);
}
