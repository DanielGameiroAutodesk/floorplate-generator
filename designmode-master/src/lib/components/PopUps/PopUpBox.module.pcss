.PopUpBox .HeaderStyle {
  height: 40px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 16px;
  padding-right: 10px;
  cursor: grab;
  border-bottom: 1px solid var(--border-color-divider-light);
}

.PopUpBox .HeaderTitleStyle {
  font-family: Artifakt Element;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
  letter-spacing: 0px;
  text-align: left;
}

.PopUpBox .HeaderIconStyle {
  width: 24px;
  height: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
}

.PopUpBox.PrimaryHeader .HeaderStyle {
  height: 48px;
}

.PopUpBox.PrimaryHeader .HeaderTitleStyle {
  font: var(--12-bold);
}

.PopUpBox.PrimaryHeader .HeaderIconStyle {
  width: 28px;
  height: 28px;
}
