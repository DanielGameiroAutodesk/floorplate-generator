.backBox {
  margin: 0 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 3px 10px;
  position: relative;
  font: var(--11-bold);

  background: var(--background-color-selected-default);
  border: 1px solid var(--border-color-selected);
  &:hover {
    background: var(--background-color-selected-hover);
  }
}
.button {
  display: flex;
  color: inherit;
  border: none;
  font-size: 16px;
  background: none;
}
